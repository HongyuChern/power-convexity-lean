private def c114NodeDependencies (root : Name) : MetaM (Std.HashSet Name) := do
  let mut seen : Std.HashSet Name := {}
  let mut todo : Array Name := #[root]
  while !todo.isEmpty do
    let c := todo.back!
    todo := todo.pop
    if !seen.contains c then
      seen := seen.insert c
      let ci ← getConstInfo c
      let vals := match ci with
        | .defnInfo v => #[v.type,v.value]
        | .thmInfo v => #[v.type,v.value]
        | .opaqueInfo v => #[v.type,v.value]
        | _ => #[ci.type]
      for e in vals do
        for d in e.getUsedConstants do
          if (d.toString.startsWith "PowerConvexity." || d.toString.startsWith "_private.PowerConvexity.") && !seen.contains d then
            todo := todo.push d
  return seen

