import PowerConvexity.Analysis.ActualGraphShearCoefficientDerivativeFour

/-! # The exact column divergence generated by a boundary graph chart -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set Filter Metric Matrix MeasureTheory
open scoped ContDiff Topology BigOperators InnerProductSpace
namespace PowerConvexity
open CHS.Calculus CHS.Analysis DeGiorgi
local notation "E" => AmbientSpace (2+2)
local notation "Mat" => Matrix (Fin (2+2)) (Fin (2+2)) ℝ
attribute [local instance] cat3 cat4 cat5 cat6 cat7 cat8 testCE pihNormSMul

theorem actual_graph_shear_column_divergence_four {N x : E} {rho : E → ℝ} {a : E → Mat}
    (hrho : ContDiffAt ℝ 2 rho x)
    (hNrho : ∀ᶠ y in 𝓝 x, fderiv ℝ rho y N = 0)
    (ha : ∀ i j, DifferentiableAt ℝ (fun y => a y i j) (actualGraphShearFour N rho x))
    (j : Fin (2+2)) :
    (∑ i, fderiv ℝ (fun y => actualGraphShearCoefficientFour N rho a y i j) x (EuclideanSpace.single i 1)) =
      (∑ k, actualShearInverseMatrixFour N (fderiv ℝ rho x) j k *
        ∑ l, fderiv ℝ (fun y => a y l k) (actualGraphShearFour N rho x) (EuclideanSpace.single l 1)) -
      N j * (∑ k, ∑ l, a (actualGraphShearFour N rho x) l k * euclideanHessian rho x l k) := by
  let H := realHessian rho x
  let Q := actualShearInverseMatrixFour N (fderiv ℝ rho x)
  let Phi := actualGraphShearFour N rho
  have hN : fderiv ℝ rho x N=0 := hNrho.self_of_nhds
  let G := actualShearLinearEquivFour N (fderiv ℝ rho x) hN
  have hDPhi : fderiv ℝ Phi x=G.toContinuousLinearMap :=
    actual_graph_shear_fderiv_equiv_four (hrho.differentiableAt (by norm_num)) hN
  have hHN (v : E) : H v N=0 := actual_normal_hessian_vanishes_four hrho hNrho v
  have hNH (v : E) : H N v=0 := (realHessian_symm hrho N v).trans (hHN v)
  have hcoord (l : Fin (2+2)) : (∑ i, N i*H (EuclideanSpace.single i 1) (EuclideanSpace.single l 1))=0 := by
    calc
      _ = H (∑ i, N i • EuclideanSpace.single i 1) (EuclideanSpace.single l 1) := by
        simp only [map_sum,map_smul,_root_.sum_apply,_root_.smul_apply,smul_eq_mul]
      _ = 0 := by rw [actual_coordinate_sum_four,hNH]
  have hQH (k l : Fin (2+2)) :
      (∑ i, Q i l*H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1)) =
        H (EuclideanSpace.single l 1) (EuclideanSpace.single k 1) := by
    simp only [Q,actualShearInverseMatrixFour,Matrix.of_apply,sub_mul,Finset.sum_sub_distrib]
    have hz : (∑ i, N i*fderiv ℝ rho x (EuclideanSpace.single l 1)*
        H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1))=0 := by
      calc
        _ = fderiv ℝ rho x (EuclideanSpace.single l 1)*
          ∑ i, N i*H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro i _
            ring
        _ = 0 := by rw [hcoord,mul_zero]
    rw [hz,sub_zero]
    simp only [Matrix.one_apply,ite_mul,one_mul,zero_mul,Finset.sum_ite_eq,Finset.sum_ite_eq',Finset.mem_univ,if_true]
  have hQA (k l : Fin (2+2)) :
      (∑ i, Q i l * fderiv ℝ (fun y => a y l k) (Phi x) (fderiv ℝ Phi x (EuclideanSpace.single i 1))) =
        fderiv ℝ (fun y => a y l k) (Phi x) (EuclideanSpace.single l 1) := by
    rw [hDPhi]
    calc
      _ = fderiv ℝ (fun y => a y l k) (Phi x)
        (∑ i, Q i l • G (EuclideanSpace.single i 1)) := by
          simp only [map_sum,map_smul,smul_eq_mul,ContinuousLinearEquiv.coe_coe]
      _ = _ := by rw [actual_shear_inverse_column_four N _ hN]
  have hfirst (k l : Fin (2+2)) :
      (∑ i, (-N i*H (EuclideanSpace.single i 1) (EuclideanSpace.single l 1))*a (Phi x) l k*Q j k)=0 := by
    calc
      _ = -(a (Phi x) l k*Q j k)*∑ i, N i*H (EuclideanSpace.single i 1) (EuclideanSpace.single l 1) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring
      _ = 0 := by rw [hcoord,mul_zero]
  have hsecond (k l : Fin (2+2)) :
      (∑ i, Q i l*fderiv ℝ (fun y => a y l k) (Phi x) (fderiv ℝ Phi x (EuclideanSpace.single i 1))*Q j k) =
        Q j k*fderiv ℝ (fun y => a y l k) (Phi x) (EuclideanSpace.single l 1) := by
    rw [← Finset.sum_mul,hQA]
    ring
  have hthird (k l : Fin (2+2)) :
      (∑ i, Q i l*a (Phi x) l k*(-N j*H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1))) =
        -N j*(a (Phi x) l k*H (EuclideanSpace.single l 1) (EuclideanSpace.single k 1)) := by
    calc
      _ = (-N j*a (Phi x) l k)*∑ i, Q i l*H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring
      _ = _ := by rw [hQH]; ring
  simp_rw [actual_graph_shear_coefficient_fderiv_four hrho ha]
  change (∑ i, ∑ k, ∑ l, ((-N i*H (EuclideanSpace.single i 1) (EuclideanSpace.single l 1))*a (Phi x) l k*Q j k +
    Q i l*fderiv ℝ (fun y => a y l k) (Phi x) (fderiv ℝ Phi x (EuclideanSpace.single i 1))*Q j k +
    Q i l*a (Phi x) l k*(-N j*H (EuclideanSpace.single i 1) (EuclideanSpace.single k 1)))) = _
  rw [Finset.sum_comm]
  conv_lhs => arg 2; ext k; rw [Finset.sum_comm]
  simp only [Finset.sum_add_distrib,hfirst,hsecond,hthird,zero_add,
    ← Finset.mul_sum,euclideanHessian,← Finset.sum_sub_distrib,← neg_mul,← Finset.sum_neg_distrib]
  simp only [H,Q,Phi,sub_eq_add_neg,neg_mul]

end PowerConvexity
