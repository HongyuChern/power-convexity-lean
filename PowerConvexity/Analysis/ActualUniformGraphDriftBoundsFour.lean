import PowerConvexity.Analysis.ActualGraphShearPhysicalScaleFour
import PowerConvexity.Analysis.ActualFlatResidualHolderFour

/-! # Uniform bounds for the drift generated by the actual boundary graph

The estimates use a common Holder bound for the original coefficients and
the graph Hessian. No derivative bound for the unknown coefficient field is
used. In particular, these are uniform over any family with those same bounds;
the existence of a boundary Holder modulus for the nonlinear family is not
asserted here.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set Filter Metric Matrix MeasureTheory
open scoped ContDiff Topology BigOperators InnerProductSpace
namespace PowerConvexity
open CHS.Calculus CHS.Analysis DeGiorgi
local notation "E" => AmbientSpace (2+2)
local notation "Mat" => Matrix (Fin (2+2)) (Fin (2+2)) ℝ
local notation "Bilin" => E →L[ℝ] E →L[ℝ] ℝ
attribute [local instance] cat3 cat4 cat5 cat6 cat7 cat8 testCE pihNormSMul

theorem actual_bilinear_coordinate_bound_four (H : Bilin) (i j : Fin (2+2)) :
    |H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)| ≤ ‖H‖ := by
  simpa only [EuclideanSpace.norm_single,norm_one,mul_one,Real.norm_eq_abs]
    using H.le_opNorm₂ (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)

theorem actual_matrix_bilinear_contraction_bound_four (A : Mat) (H : Bilin) :
    |∑ i, ∑ j, A i j * H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)| ≤
      16*‖actualMatrixOperatorTwo A‖*‖H‖ := by
  calc
    _ ≤ ∑ i, |∑ j, A i j * H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : Fin (2+2), ∑ _j : Fin (2+2), ‖actualMatrixOperatorTwo A‖*‖H‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply (Finset.abs_sum_le_sum_abs _ _).trans
      apply Finset.sum_le_sum
      intro j _
      rw [abs_mul]
      exact mul_le_mul (actual_matrix_entry_le_operator_norm_four A i j)
        (actual_bilinear_coordinate_bound_four H i j) (abs_nonneg _) (norm_nonneg _)
    _ = _ := by simp; ring

theorem actual_matrix_bilinear_contraction_difference_four
    (A B : Mat) (H K : Bilin) :
    |(∑ i, ∑ j, A i j * H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)) -
        ∑ i, ∑ j, B i j * K (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)| ≤
      16*(‖actualMatrixOperatorTwo A-actualMatrixOperatorTwo B‖*‖H‖+
        ‖actualMatrixOperatorTwo B‖*‖H-K‖) := by
  have he : (∑ i, ∑ j, A i j * H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)) -
        ∑ i, ∑ j, B i j * K (EuclideanSpace.single i 1) (EuclideanSpace.single j 1) =
      (∑ i, ∑ j, (A-B) i j * H (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)) +
        ∑ i, ∑ j, B i j * (H-K) (EuclideanSpace.single i 1) (EuclideanSpace.single j 1) := by
    simp only [Matrix.sub_apply,_root_.sub_apply,sub_mul,mul_sub,Finset.sum_sub_distrib]
    ring
  rw [he]
  exact (abs_add_le _ _).trans ((add_le_add
    (actual_matrix_bilinear_contraction_bound_four (A-B) H)
    (actual_matrix_bilinear_contraction_bound_four B (H-K))).trans_eq (by rw [map_sub]; ring))

theorem actual_graph_drift_uniform_bound_four {N : E} {rho : E → ℝ} {a : E → Mat}
    {V : Set E} {A H : ℝ} (hA : 0 ≤ A) (hH : 0 ≤ H)
    (ha : ∀ x ∈ V, ‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho x))‖ ≤ A)
    (hrho : ∀ x ∈ V, ‖realHessian rho x‖ ≤ H) :
    ∀ x ∈ V, ‖actualGraphShearDriftFieldFour N rho a x‖ ≤ (16*A*H)*‖N‖ := by
  intro x hx
  rw [actualGraphShearDriftFieldFour,norm_smul,Real.norm_eq_abs,abs_neg]
  have hsum : |∑ k, ∑ l, a (actualGraphShearFour N rho x) l k*euclideanHessian rho x l k| ≤
      16*‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho x))‖*‖realHessian rho x‖ := by
    rw [Finset.sum_comm]
    exact actual_matrix_bilinear_contraction_bound_four _ _
  apply mul_le_mul_of_nonneg_right (hsum.trans ?_) (norm_nonneg N)
  exact mul_le_mul (mul_le_mul_of_nonneg_left (ha x hx) (by norm_num))
    (hrho x hx) (by positivity) (by positivity)

theorem actual_graph_drift_uniform_holder_four {N : E} {rho : E → ℝ} {a : E → Mat}
    {V : Set E} {A H Ka Kh alpha : ℝ} (hA : 0 ≤ A) (hH : 0 ≤ H)
    (hKa : 0 ≤ Ka) (hKh : 0 ≤ Kh)
    (ha : ∀ x ∈ V, ‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho x))‖ ≤ A)
    (hHess : ∀ x ∈ V, ‖realHessian rho x‖ ≤ H)
    (haHolder : ∀ x ∈ V, ∀ y ∈ V,
      ‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho x))-
        actualMatrixOperatorTwo (a (actualGraphShearFour N rho y))‖ ≤ Ka*‖x-y‖^alpha)
    (hHessHolder : ∀ x ∈ V, ∀ y ∈ V,
      ‖realHessian rho x-realHessian rho y‖ ≤ Kh*‖x-y‖^alpha) :
    ∀ x ∈ V, ∀ y ∈ V,
      ‖actualGraphShearDriftFieldFour N rho a x-actualGraphShearDriftFieldFour N rho a y‖ ≤
        (16*(Ka*H+A*Kh)*‖N‖)*‖x-y‖^alpha := by
  intro x hx y hy
  have he : actualGraphShearDriftFieldFour N rho a x-actualGraphShearDriftFieldFour N rho a y =
      -((∑ i, ∑ j, a (actualGraphShearFour N rho x) i j*euclideanHessian rho x i j)-
        ∑ i, ∑ j, a (actualGraphShearFour N rho y) i j*euclideanHessian rho y i j) • N := by
    simp only [actualGraphShearDriftFieldFour,← sub_smul]
    congr 1
    rw [Finset.sum_comm,Finset.sum_comm (f := fun k l =>
      a (actualGraphShearFour N rho y) l k*euclideanHessian rho y l k)]
    ring
  rw [he,norm_smul,Real.norm_eq_abs,abs_neg]
  have hc := actual_matrix_bilinear_contraction_difference_four
    (a (actualGraphShearFour N rho x)) (a (actualGraphShearFour N rho y))
    (realHessian rho x) (realHessian rho y)
  have hb : 16*(‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho x))-
        actualMatrixOperatorTwo (a (actualGraphShearFour N rho y))‖*‖realHessian rho x‖+
      ‖actualMatrixOperatorTwo (a (actualGraphShearFour N rho y))‖*
        ‖realHessian rho x-realHessian rho y‖) ≤
      (16*(Ka*H+A*Kh))*‖x-y‖^alpha := by
    calc
      _ ≤ 16*((Ka*‖x-y‖^alpha)*H+A*(Kh*‖x-y‖^alpha)) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact add_le_add
          (mul_le_mul (haHolder x hx y hy) (hHess x hx) (by positivity) (by positivity))
          (mul_le_mul (ha y hy) (hHessHolder x hx y hy) (by positivity) hA)
      _ = _ := by ring
  exact (mul_le_mul_of_nonneg_right (hc.trans hb) (norm_nonneg N)).trans_eq (by ring)

theorem actual_holder_graph_composition_four {F : Type*}
    [NormedAddCommGroup F] {g : E → F} {N : E} {rho : E → ℝ}
    {U V : Set E} {K L alpha : ℝ} (hK : 0 ≤ K) (hL : 0 ≤ L) (halpha : 0 ≤ alpha)
    (hmap : MapsTo (actualGraphShearFour N rho) V U)
    (hLip : ∀ x ∈ V, ∀ y ∈ V,
      ‖actualGraphShearFour N rho x-actualGraphShearFour N rho y‖ ≤ L*‖x-y‖)
    (hg : ∀ x ∈ U, ∀ y ∈ U, ‖g x-g y‖ ≤ K*‖x-y‖^alpha) :
    ∀ x ∈ V, ∀ y ∈ V,
      ‖g (actualGraphShearFour N rho x)-g (actualGraphShearFour N rho y)‖ ≤
        (K*L^alpha)*‖x-y‖^alpha := by
  intro x hx y hy
  calc
    _ ≤ K*‖actualGraphShearFour N rho x-actualGraphShearFour N rho y‖^alpha :=
      hg _ (hmap hx) _ (hmap hy)
    _ ≤ K*(L*‖x-y‖)^alpha := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (norm_nonneg _) (hLip x hx y hy) halpha) hK
    _ = _ := by rw [Real.mul_rpow hL (norm_nonneg _)]; ring

end PowerConvexity
